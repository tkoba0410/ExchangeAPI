<Project>

  <!--
    Phase2-3: Enforce layer adjacency rules by failing build on forbidden ProjectReference.

    Categories (by folder):
      Transport   : src/Transport/**
      Primitives  : src/Primitives/**
      Application : src/Application/**
      Composition : src/Composition/**
      Contracts   : src/Contracts/Common/**, src/Contracts/Facade/**
      Exchanges   : src/Exchanges/<Exchange>/<Layer>/**

    Allowed (minimal, conservative):
      Transport     -> Primitives
      Primitives    -> (no constraints)
      Application   -> Primitives
      Composition   -> Contracts.Facade, Application, Transport, Primitives, Exchange Adapter
      Contracts.Facade -> Contracts.Common
      Contracts.Common -> Primitives
      Exchange Wire -> Transport, Primitives
      Exchange Raw  -> Exchange Wire, Contracts.Common, Primitives
      Exchange Normalized -> Exchange Raw, Contracts.Common, Contracts.Facade, Primitives, Application
      Exchange Adapter -> Exchange Normalized, Contracts.Facade, Primitives, Application, Transport

    Notes:
      - This checks ProjectReference only (not Compile Include). Phase2 already removes cross-layer Compile Include.
      - Tests are excluded by default.
      - Path checks are written to work on both Windows and non-Windows MSBuild.
  -->

  <PropertyGroup>
    <!-- Opt-out switch (rarely needed) -->
    <EnforceLayerReferences Condition="'$(EnforceLayerReferences)'==''">true</EnforceLayerReferences>
    <EnforcePhysicalLayout Condition="'$(EnforcePhysicalLayout)'==''">true</EnforcePhysicalLayout>
  </PropertyGroup>

  <Target Name="ValidateLayerReferences"
          BeforeTargets="PrepareForBuild"
          Condition="'$(EnforceLayerReferences)'=='true' and '$(MSBuildProjectDirectory)'!=''">

    <!-- Determine current layer by project directory -->
    <PropertyGroup>
      <_Dir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))</_Dir>

      <!-- Exclude tests robustly -->
      <_IsTests Condition="$(_Dir.Contains('\tests\')) Or $(_Dir.Contains('/tests/'))">true</_IsTests>

      <!-- Apply only to src -->
      <_IsInSrc Condition="$(_Dir.Contains('\src\')) Or $(_Dir.Contains('/src/'))">true</_IsInSrc>

      <_IsTransport Condition="$(_Dir.Contains('\src\Transport\')) Or $(_Dir.Contains('/src/Transport/'))">true</_IsTransport>
      <_IsPrimitives Condition="$(_Dir.Contains('\src\Primitives\')) Or $(_Dir.Contains('/src/Primitives/'))">true</_IsPrimitives>
      <_IsApplication Condition="$(_Dir.Contains('\src\Application\')) Or $(_Dir.Contains('/src/Application/'))">true</_IsApplication>
      <_IsComposition Condition="$(_Dir.Contains('\src\Composition\')) Or $(_Dir.Contains('/src/Composition/'))">true</_IsComposition>
      <_IsContractsCommon Condition="$(_Dir.Contains('\src\Contracts\Common\')) Or $(_Dir.Contains('/src/Contracts/Common/'))">true</_IsContractsCommon>
      <_IsContractsFacade Condition="$(_Dir.Contains('\src\Contracts\Facade\')) Or $(_Dir.Contains('/src/Contracts/Facade/'))">true</_IsContractsFacade>
      <_IsExchangeWire Condition="$(_Dir.Contains('\src\Exchanges\')) and ($(_Dir.Contains('\Wire\')) Or $(_Dir.Contains('/Wire/')))">true</_IsExchangeWire>
      <_IsExchangeRaw Condition="$(_Dir.Contains('\src\Exchanges\')) and ($(_Dir.Contains('\Raw\')) Or $(_Dir.Contains('/Raw/')))">true</_IsExchangeRaw>
      <_IsExchangeNormalized Condition="$(_Dir.Contains('\src\Exchanges\')) and ($(_Dir.Contains('\Normalized\')) Or $(_Dir.Contains('/Normalized/')))">true</_IsExchangeNormalized>
      <_IsExchangeAdapter Condition="$(_Dir.Contains('\src\Exchanges\')) and ($(_Dir.Contains('\Adapter\')) Or $(_Dir.Contains('/Adapter/')))">true</_IsExchangeAdapter>
    </PropertyGroup>

    <ItemGroup Condition="'$(_IsInSrc)'=='true' and '$(_IsTests)'!='true'">
      <_PR Include="@(ProjectReference)" />
    </ItemGroup>

    <!-- Helper: classify each referenced path -->
    <ItemGroup Condition="'$(_IsInSrc)'=='true' and '$(_IsTests)'!='true'">
      <_PR_Transport Include="@(_PR)"
                     Condition="$([System.String]::Copy('%(_PR.Identity)').Contains('\src\Transport\')) Or $([System.String]::Copy('%(_PR.Identity)').Contains('/src/Transport/'))" />
      <_PR_Primitives Include="@(_PR)"
                      Condition="$([System.String]::Copy('%(_PR.Identity)').Contains('\src\Primitives\')) Or $([System.String]::Copy('%(_PR.Identity)').Contains('/src/Primitives/'))" />
      <_PR_Application Include="@(_PR)"
                       Condition="$([System.String]::Copy('%(_PR.Identity)').Contains('\src\Application\')) Or $([System.String]::Copy('%(_PR.Identity)').Contains('/src/Application/'))" />
      <_PR_Composition Include="@(_PR)"
                       Condition="$([System.String]::Copy('%(_PR.Identity)').Contains('\src\Composition\')) Or $([System.String]::Copy('%(_PR.Identity)').Contains('/src/Composition/'))" />
      <_PR_ContractsCommon Include="@(_PR)"
                           Condition="$([System.String]::Copy('%(_PR.Identity)').Contains('\src\Contracts\Common\')) Or $([System.String]::Copy('%(_PR.Identity)').Contains('/src/Contracts/Common/'))" />
      <_PR_ContractsFacade Include="@(_PR)"
                           Condition="$([System.String]::Copy('%(_PR.Identity)').Contains('\src\Contracts\Facade\')) Or $([System.String]::Copy('%(_PR.Identity)').Contains('/src/Contracts/Facade/'))" />
      <_PR_ExchangeWire Include="@(_PR)"
                        Condition="($([System.String]::Copy('%(_PR.Identity)').Contains('\src\Exchanges\')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('\Wire\')))) Or ($([System.String]::Copy('%(_PR.Identity)').Contains('/src/Exchanges/')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('/Wire/'))))" />
      <_PR_ExchangeRaw Include="@(_PR)"
                       Condition="($([System.String]::Copy('%(_PR.Identity)').Contains('\src\Exchanges\')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('\Raw\')))) Or ($([System.String]::Copy('%(_PR.Identity)').Contains('/src/Exchanges/')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('/Raw/'))))" />
      <_PR_ExchangeNormalized Include="@(_PR)"
                              Condition="($([System.String]::Copy('%(_PR.Identity)').Contains('\src\Exchanges\')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('\Normalized\')))) Or ($([System.String]::Copy('%(_PR.Identity)').Contains('/src/Exchanges/')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('/Normalized/'))))" />
      <_PR_ExchangeAdapter Include="@(_PR)"
                           Condition="($([System.String]::Copy('%(_PR.Identity)').Contains('\src\Exchanges\')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('\Adapter\')))) Or ($([System.String]::Copy('%(_PR.Identity)').Contains('/src/Exchanges/')) and ($([System.String]::Copy('%(_PR.Identity)').Contains('/Adapter/'))))" />
    </ItemGroup>

    <!-- TRANSPORT: must not reference Application/Composition/Contracts/Exchanges -->
    <Error Condition="'$(_IsTransport)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_Application)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ContractsCommon)'!='' or '@(_PR_ContractsFacade)'!='' or '@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='')"
           Text="[LayerRules] Transport project must only reference Primitives." />

    <!-- PRIMITIVES: must not reference other categories -->
    <Error Condition="'$(_IsPrimitives)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_Transport)'!='' or '@(_PR_Application)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ContractsCommon)'!='' or '@(_PR_ContractsFacade)'!='' or '@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='')"
           Text="[LayerRules] Primitives project must not reference other categories." />

    <!-- APPLICATION: must not reference Transport/Composition/Contracts/Exchanges -->
    <Error Condition="'$(_IsApplication)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_Transport)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ContractsCommon)'!='' or '@(_PR_ContractsFacade)'!='' or '@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='')"
           Text="[LayerRules] Application project may reference only Primitives." />

    <!-- CONTRACTS.COMMON: must not reference Application/Composition/Exchanges/Contracts.Facade -->
    <Error Condition="'$(_IsContractsCommon)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_Application)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ContractsFacade)'!='' or '@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='')"
           Text="[LayerRules] Contracts.Common may reference only Primitives." />

    <!-- CONTRACTS.FACADE: must not reference Application/Composition/Exchanges/Transport -->
    <Error Condition="'$(_IsContractsFacade)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_Transport)'!='' or '@(_PR_Application)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='')"
           Text="[LayerRules] Contracts.Facade may reference only Contracts.Common." />

    <!-- EXCHANGE WIRE: must not reference Raw/Normalized/Adapter/Composition -->
    <Error Condition="'$(_IsExchangeWire)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ContractsCommon)'!='' or '@(_PR_ContractsFacade)'!='')"
           Text="[LayerRules] Exchange Wire may reference only Transport and Primitives." />

    <!-- EXCHANGE RAW: must not reference Normalized/Adapter/Composition/Transport -->
    <Error Condition="'$(_IsExchangeRaw)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_ExchangeNormalized)'!='' or '@(_PR_ExchangeAdapter)'!='' or '@(_PR_Composition)'!='' or '@(_PR_Transport)'!='')"
           Text="[LayerRules] Exchange Raw may reference only Exchange Wire, Contracts.Common, and Primitives." />

    <!-- EXCHANGE NORMALIZED: must not reference Wire/Adapter/Composition -->
    <Error Condition="'$(_IsExchangeNormalized)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeAdapter)'!='' or '@(_PR_Composition)'!='')"
           Text="[LayerRules] Exchange Normalized may reference only Exchange Raw, Contracts.Common, Contracts.Facade, Primitives, and Application." />

    <!-- EXCHANGE ADAPTER: must not reference Wire/Raw/Composition/Contracts.Common -->
    <Error Condition="'$(_IsExchangeAdapter)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_Composition)'!='' or '@(_PR_ContractsCommon)'!='')"
           Text="[LayerRules] Exchange Adapter may reference only Exchange Normalized, Contracts.Facade, Primitives, Application, and Transport." />

    <!-- COMPOSITION: must not reference Exchange Wire/Raw/Normalized -->
    <Error Condition="'$(_IsComposition)'=='true' and '$(_IsTests)'!='true' and ('@(_PR_ExchangeWire)'!='' or '@(_PR_ExchangeRaw)'!='' or '@(_PR_ExchangeNormalized)'!='')"
           Text="[LayerRules] Composition must not reference Exchange Wire/Raw/Normalized." />

  </Target>

  <Target Name="ValidatePhysicalLayout"
          BeforeTargets="PrepareForBuild"
          Condition="'$(EnforcePhysicalLayout)'=='true'">

    <PropertyGroup>
      <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_RepoRoot>
      <_SrcRoot>$([System.IO.Path]::Combine('$(_RepoRoot)', 'src'))</_SrcRoot>
      <_SrcRootExists>$([System.IO.Directory]::Exists('$(_SrcRoot)'))</_SrcRootExists>
    </PropertyGroup>

    <ItemGroup Condition="'$(_SrcRootExists)'=='true'">
      <_TopDirs Include="$([System.IO.Directory]::GetDirectories('$(_SrcRoot)'))" />
      <_AllowedTopDirs Include="$([System.IO.Path]::Combine('$(_SrcRoot)', 'Transport'))" />
      <_AllowedTopDirs Include="$([System.IO.Path]::Combine('$(_SrcRoot)', 'Primitives'))" />
      <_AllowedTopDirs Include="$([System.IO.Path]::Combine('$(_SrcRoot)', 'Application'))" />
      <_AllowedTopDirs Include="$([System.IO.Path]::Combine('$(_SrcRoot)', 'Composition'))" />
      <_AllowedTopDirs Include="$([System.IO.Path]::Combine('$(_SrcRoot)', 'Exchanges'))" />
      <_AllowedTopDirs Include="$([System.IO.Path]::Combine('$(_SrcRoot)', 'Contracts'))" />
      <_ExtraTopDirs Include="@(_TopDirs)" />
      <_ExtraTopDirs Remove="@(_AllowedTopDirs)" />
    </ItemGroup>

    <Error Condition="'@(_ExtraTopDirs)'!=''"
           Text="[LayoutRules] src/ contains disallowed folders: @(_ExtraTopDirs->'%(Filename)', ', ')" />

  </Target>

</Project>
