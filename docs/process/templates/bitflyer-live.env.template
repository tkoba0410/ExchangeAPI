# bitFlyer live tests are opt-in.
EXCHANGEAPI_BITFLYER_LIVE=1

# Authenticated tests (Normalized public / all private tests).
# You can either set direct credentials here,
# or rely on CREDENTIAL_FILE_PATH / AGE_SECRET_KEY_PATH (or their default ~/.config paths).
EXCHANGEAPI_BITFLYER_API_KEY=<set-outside-repo>
EXCHANGEAPI_BITFLYER_API_SECRET=<set-outside-repo>
EXCHANGEAPI_BITFLYER_LIVE_ACCOUNT_ID=default

# Optional market override. Defaults are BTC/JPY and BTC_JPY.
EXCHANGEAPI_BITFLYER_LIVE_SYMBOL=BTC/JPY
EXCHANGEAPI_BITFLYER_LIVE_PRODUCT_CODE=BTC_JPY

# Private POST tests are disabled unless explicitly enabled.
EXCHANGEAPI_BITFLYER_LIVE_ALLOW_POST=0

# Required only when EXCHANGEAPI_BITFLYER_LIVE_ALLOW_POST=1.
# Use a dedicated test account, minimum size, and a limit price that should not fill immediately.
EXCHANGEAPI_BITFLYER_LIVE_ORDER_SIDE=BUY
EXCHANGEAPI_BITFLYER_LIVE_ORDER_SIZE=0.001
EXCHANGEAPI_BITFLYER_LIVE_ORDER_PRICE=1000
