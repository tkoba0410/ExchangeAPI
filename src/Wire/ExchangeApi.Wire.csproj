<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RootNamespace>ExchangeApi</RootNamespace>
  </PropertyGroup>

  <!-- IMPORTANT:
       core.transport is still compiled by Core/Core.csproj (Phase1 behavior-keep).
       If Wire also compiles core.transport, downstream projects that reference both Core and Wire
       can hit CS0433 (type exists in both assemblies). Exclude it here. -->
  <ItemGroup>
    <Compile Remove="Common\core.transport\**\*.cs" />
    <Compile Remove="Common/core.transport/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Contracts\Common\DomainCommon\Shared.Common.csproj" />
    <ProjectReference Include="..\Contracts\Common\CallCommon\Spec.CallCommon.csproj" />
  </ItemGroup>

</Project>
